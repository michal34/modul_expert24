		"@types/react-dom": "^19.2.3",
		"autoprefixer": "^10.4.24",
		"eslint": "9.39.5",
		"eslint-config-next": "16.2.11",
		"postcss": "^8.5.22",
		"prettier": "^3.8.1",
		"tailwindcss": "^3.4.4",
		"typescript": "^5"
	},
	"overrides": {
